# Databricks Connection
# Get these from your Databricks workspace settings
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Optional: Specify warehouse ID (auto-selects serverless if not provided)
DATABRICKS_WAREHOUSE_ID=

# Workspace Paths
# ⚠️  IMPORTANT: Update this with your actual Databricks workspace user path
# Format: /Users/your.email@company.com/LMIP
WORKSPACE_ROOT=/Users/your.email@company.com/LMIP

# Unity Catalog Configuration
CATALOG=workspace
BRONZE_SCHEMA=bronze
SILVER_SCHEMA=silver
INTERMEDIATE_SCHEMA=intermediate
GOLD_SCHEMA=gold
REPORTING_SCHEMA=reporting
METADATA_SCHEMA=metadata
AUDIT_SCHEMA=audit
QUARANTINE_SCHEMA=quarantine
PUBLISH_SCHEMA=publish

# Notification Settings
# Update with your email for job notifications
NOTIFICATION_EMAIL=your.email@company.com

# Compute Settings
# Leave DEFAULT_CLUSTER_ID empty to use serverless compute (recommended)
DEFAULT_CLUSTER_ID=
USE_SERVERLESS=true

# Deployment Options (override via CLI flags)
DRY_RUN=false
UPDATE_EXISTING=false
FORCE_DEPLOY=false
