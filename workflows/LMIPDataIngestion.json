{
  "name": "LMIPDataIngestion",
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "trigger": {
    "pause_status": "UNPAUSED",
    "periodic": {
      "interval": 1,
      "unit": "HOURS"
    }
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "Arbeit_Ingestor",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "${workspace_root}/notebooks/ingestion/ingest_arbeitnow",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "environment_key": "Default",
      "disabled": false
    },
    {
      "task_key": "Remotive_Ingestor",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "${workspace_root}/notebooks/ingestion/ingest_remotive",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "environment_key": "Default",
      "disabled": false
    },
    {
      "task_key": "API_Log",
      "depends_on": [
        {
          "task_key": "Arbeit_Ingestor"
        },
        {
          "task_key": "Remotive_Ingestor"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "${workspace_root}/notebooks/bronze/bronze_write_api_response_log",
        "base_parameters": {
          "catalog": "workspace",
          "schema": "bronze"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "environment_key": "Default",
      "disabled": false
    },
    {
      "task_key": "Job_Snapshot",
      "depends_on": [
        {
          "task_key": "API_Log"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "${workspace_root}/notebooks/bronze/bronze_write_job_snapshot",
        "base_parameters": {
          "catalog": "workspace",
          "schema": "bronze"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "environment_key": "Default",
      "disabled": false
    },
    {
      "task_key": "Dedupe_Check",
      "depends_on": [
        {
          "task_key": "Job_Snapshot"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "${workspace_root}/notebooks/bronze/bronze_dedupe_raw_payload",
        "base_parameters": {
          "catalog": "workspace",
          "schema": "bronze"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "environment_key": "Default",
      "disabled": false
    },
    {
      "task_key": "Finalise_Batch",
      "depends_on": [
        {
          "task_key": "Dedupe_Check"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "${workspace_root}/notebooks/bronze/bronze_finalize_batch",
        "base_parameters": {
          "catalog": "workspace",
          "schema": "bronze"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "environment_key": "Default",
      "disabled": false
    },
    {
      "task_key": "Log_Pipeline_Execution",
      "depends_on": [
        {
          "task_key": "Finalise_Batch"
        }
      ],
      "run_if": "ALL_DONE",
      "notebook_task": {
        "notebook_path": "${workspace_root}/notebooks/audit/log_pipeline_run",
        "source": "WORKSPACE",
        "base_parameters": {
          "pipeline_name": "LMIPDataIngestion",
          "run_id": "{{run_id}}",
          "status": "{{tasks.Finalise_Batch.state}}",
          "start_time": "{{start_time}}",
          "rows_read": "0",
          "rows_written": "0",
          "catalog": "workspace",
          "schema": "audit"
        }
      },
      "timeout_seconds": 600,
      "max_retries": 2,
      "email_notifications": {},
      "environment_key": "Default"
    },
    {
      "task_key": "Notify_On_Failure",
      "depends_on": [
        {
          "task_key": "Finalise_Batch"
        }
      ],
      "run_if": "AT_LEAST_ONE_FAILED",
      "notebook_task": {
        "notebook_path": "${workspace_root}/notebooks/audit/audit_notification_dispatch",
        "source": "WORKSPACE",
        "base_parameters": {
          "notification_type": "critical_alert",
          "alert_severity": "HIGH",
          "alert_title": "LMIPDataIngestion Pipeline Failed",
          "alert_message": "Pipeline LMIPDataIngestion (Run ID: {{run_id}}) encountered failures. Check audit logs and investigate immediately.",
          "alert_context": "{\"workflow_name\": \"LMIPDataIngestion\", \"run_id\": \"{{run_id}}\", \"run_page_url\": \"{{run_page_url}}\"}",
          "recipient_list": "aaryan.shrivastav1403@gmail.com,data-ops-team@company.com",
          "channel": "email"
        }
      },
      "timeout_seconds": 600,
      "max_retries": 2,
      "email_notifications": {},
      "environment_key": "Default"
    }
  ],
  "format": "MULTI_TASK",
  "queue": {
    "enabled": true
  },
  "environments": [
    {
      "environment_key": "Default",
      "spec": {
        "environment_version": "5"
      }
    }
  ],
  "performance_target": "PERFORMANCE_OPTIMIZED"
}